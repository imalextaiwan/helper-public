<?xml version="1.0" encoding="utf-8"?>
<!--
  Helper 3.0 系統設定任務清單 system_tasks.xml 的格式（設計第 4.3 節）

  和 system_tasks.xml 放在同一個資料夾，供編輯器即時檢查；Helper 執行時不讀這個檔案（Q6）。
  每個任務的腳本固定為 tasks\<id>.cmd，XML 不另外寫路徑；腳本是否存在由程式檢查。
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="systemTasks">
    <xs:annotation>
      <xs:documentation xml:lang="zh-TW">系統設定任務清單。排列順序就是介面顯示與執行的順序。</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="category" type="categoryType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="timeout" type="xs:positiveInteger">
        <xs:annotation>
          <xs:documentation xml:lang="zh-TW">每個任務的逾時，單位是秒；省略時為 300 秒。</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
    <xs:unique name="uniqueCategoryId">
      <xs:selector xpath="category"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="uniqueTaskId">
      <xs:selector xpath="category/task"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

  <xs:complexType name="categoryType">
    <xs:annotation>
      <xs:documentation xml:lang="zh-TW">一個分類，介面上顯示為一個區塊。</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="task" type="taskType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="idType" use="required"/>
    <xs:attribute name="name" type="nonBlankType" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="zh-TW">介面上顯示的分類名稱。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="taskType">
    <xs:annotation>
      <xs:documentation xml:lang="zh-TW">一個任務，執行 tasks\&lt;id&gt;.cmd。子元素的順序不限。</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="name" type="nonBlankType">
        <xs:annotation>
          <xs:documentation xml:lang="zh-TW">介面上顯示的名稱。</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="description" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="zh-TW">說明（選填）。</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
    <xs:attribute name="id" type="idType" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="zh-TW">只能用小寫英文、數字、底線，在整個檔案內不可重複；也是腳本的檔名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="idType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9_]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="nonBlankType">
    <xs:restriction base="xs:string">
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
